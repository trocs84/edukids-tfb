# Local por defecto: PostgreSQL embebido persistente en .data/postgres.
EDUKIDS_DATA_MODE=local
# Completar solo al migrar a un proyecto Supabase propio.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Obligatorio en modo supabase; en local se genera en .data/gate.key.
PARENT_GATE_SECRET=
# Origen público exacto (https://...) obligatorio al desplegar; vacío en local.
APP_ORIGIN=
